#include <iostream>

int main() {
    int marks[5];
    int total = 0;
    double average;

    std::cout << "Enter marks for 5 subjects (out of 100):\n";
    for(int i = 0; i < 5; i++) {
        std::cout << "Subject " << i + 1 << ": ";
        std::cin >> marks[i];
        total += marks[i];
    }

    average = total / 5.0;

    std::cout << "\n--- Student Report ---\n";
    std::cout << "Total Marks: " << total << "/500\n";
    std::cout << "Average Percentage: " << average << "%\n";

    std::cout << "Grade: ";
    if(average >= 90) std::cout << "A+";
    else if(average >= 80) std::cout << "A";
    else if(average >= 70) std::cout << "B";
    else if(average >= 60) std::cout << "C";
    else if(average >= 50) std::cout << "D";
    else std::cout << "Fail (F)";
    std::cout << std::endl;

    return 0;
}
